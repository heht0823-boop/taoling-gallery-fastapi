# ====================== 应用基础环境配置 ======================
# 环境标识：development开发环境 | production生产环境
APP_ENV=development
# 服务监听IP，127.0.0.1仅本机访问；0.0.0.0允许局域网其他设备访问
APP_HOST=127.0.0.1
# 服务端口
APP_PORT=8000
# 后端对外访问基础URL，上传图片生成完整访问地址会使用该值
APP_URL=http://127.0.0.1:8000
# CORS跨域允许前端来源，Vite默认端口5173，多个地址逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ====================== MySQL数据库配置 ======================
# 数据库地址，本地MySQL
DB_HOST=127.0.0.1
# MySQL默认端口
DB_PORT=3306
# 数据库名，需要手动提前创建 taoling_gallery
DB_NAME=taoling_gallery
# 数据库账号
DB_USER=root
# 数据库密码【请修改为自己的数据库密码】
DB_PASSWORD=

# ===================== JWT登录鉴权 & Cookie配置 =====================
# JWT签名密钥，生产环境务必替换为随机强字符串，不要使用示例密钥【务必替换】
JWT_SECRET=change_me_to_random_long_string
# JWT令牌过期时间 7d=7天
JWT_EXPIRES_IN=7d
# 登录态Cookie名称
AUTH_COOKIE_NAME=taoling_auth
# Cookie SameSite策略 lax：允许部分跨站场景携带cookie；生产不要改成none
AUTH_COOKIE_SAMESITE=lax
# Cookie Secure开关：开发环境false；生产HTTPS环境必须改为true，仅https可携带cookie
AUTH_COOKIE_SECURE=false
# Cookie绑定域名，本地开发留空；线上部署填写域名如 .xxx.com
AUTH_COOKIE_DOMAIN=
# Cookie最大存活时间7天
AUTH_COOKIE_MAX_AGE=7d

# ====================== 文件上传&图片处理配置 =====================
# 图片文件存储根目录，项目根下uploads文件夹
UPLOAD_ROOT=./uploads
# 单文件上传最大大小，单位MB
UPLOAD_MAX_SIZE_MB=20
# 图片优化输出格式 webp体积更小
IMAGE_OPTIMIZER_FORMAT=webp
# 图片压缩质量 0‑100，数值越大画质越高体积越大
IMAGE_OPTIMIZER_QUALITY=78
# 缩略图thumbnail生成宽度，高度按原图比例自动缩放
IMAGE_THUMBNAIL_WIDTH=420
# 外部图片处理服务URL查询参数模板，为空代表本地PIL处理图片，不使用第三方服务
IMAGE_OPTIMIZER_QUERY_TEMPLATE=
# 外部图片处理服务地址模板，为空代表本地处理
IMAGE_OPTIMIZER_URL_TEMPLATE=

# ====================== 阿里云内容安全（UGC审核） =====================
# 是否开启内容安全审核 false关闭，开发环境建议关闭避免产生云费用
CONTENT_SECURITY_ENABLED=false
# 阿里云AccessKey ID，开启审核时必填【开启审核请填写】
ALI_ACCESS_KEY_ID=
# 阿里云AccessKey Secret，开启审核时必填【开启审核请填写】
ALI_ACCESS_KEY_SECRET=
# 阿里云服务地域 上海
ALI_REGION_ID=cn-shanghai
# 文本审核接口动作
ALI_TEXT_ACTION=TextModerationPlus
# UGC大模型内容安全服务名称
ALI_SERVICE_NAME=ugc_moderation_byllm_pro
# 阿里云绿网接口端点
ALI_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
# API版本号，固定不要修改
ALI_API_VERSION=2022-03-02
# 阿里云接口超时时间，单位毫秒，15秒
ALI_TIMEOUT_MS=15000

# ====================== 高德地图天气接口配置 =====================
# 高德开放平台key，为空地图天气功能直接禁用【需要地图天气请填写】
AMAP_KEY=
# 实时天气缓存时长，单位分钟，减少调用高德API
AMAP_LIVE_CACHE_MINUTES=30
# 天气预报缓存时长，单位分钟，360分钟=6小时
AMAP_FORECAST_CACHE_MINUTES=360

# ====================== 阿里云通义千问DashScope AI大模型 =====================
# 阿里云百炼API‑KEY，为空AI标签、AI描述功能禁用【需要AI能力请填写】
DASHSCOPE_API_KEY=
# 兼容OpenAI协议接口地址，固定值不要修改
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 使用的大模型 qwen‑plus
DASHSCOPE_MODEL=qwen-plus
# AI接口超时时间，单位毫秒，30秒，大模型生成耗时较长
AI_TIMEOUT_MS=30000

# ====================== 系统初始化管理员账号 =====================
# 后台管理员用户名
ADMIN_USERNAME=hetao
# 管理员邮箱
ADMIN_EMAIL=admin@taoling.local
# ⚠️重要：项目启动初始化管理员依赖该值，【请修改为自己的管理员密码】
ADMIN_PASSWORD=
